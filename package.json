{
  "name": "@mcarvin/smart-diff",
  "version": "6.0.0",
  "description": "Generates AI-powered natural-language summaries of git diffs for code review.",
  "author": "Matt Carvin",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/typings/index.d.ts",
  "bin": {
    "smart-diff": "dist/cli.cjs"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx rollup -c",
    "start": "node dist/index.cjs",
    "test": "vitest run --coverage",
    "lint": "biome lint .",
    "lint:dependencies": "knip",
    "lint:engine": "ls-engines --no-current --no-dev --mode=virtual",
    "format": "biome format --write .",
    "prepack": "npm run build",
    "prepare": "husky",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "node scripts/incremental-mutation.mjs"
  },
  "lint-staged": {
    "**/*.{js,ts,cjs,mjs}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.5",
    "husky": "9.1.7",
    "knip": "6.32.1",
    "lint-staged": "16.3.3",
    "ls-engines": "0.10.1",
    "rollup": "4.62.4",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@scolladon/tsgit": "3.4.0",
    "diff": "9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcarvin8/smart-diff.git"
  },
  "bugs": {
    "url": "https://github.com/mcarvin8/smart-diff/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "anthropic",
    "bedrock",
    "claude",
    "cli",
    "code-review",
    "cohere",
    "deepseek",
    "diff",
    "gemini",
    "git",
    "git-diff",
    "google",
    "groq",
    "grok",
    "llm",
    "mistral",
    "openai",
    "openai-compatible",
    "pull-request",
    "summary",
    "xai"
  ]
}
